<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (API 37) pide este permiso para conectarse a IPs privadas, como 10.0.2.2 en el
         puente entre emuladores. En emuladores se concede con `adb shell pm grant` (ver EMULADORES.md). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application>
        <!-- Recibe los paquetes del otro dispositivo (teléfono <-> reloj) -->
        <service
            android:name=".sync.ServicioSincronizacion"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/memoflash"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/memoflash_"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
